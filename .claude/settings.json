{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew :*:compileAndroidMain*)",
      "Bash(./gradlew :*:compileKotlinDesktop*)",
      "Bash(./gradlew :*:testAndroidHostTest*)",
      "Bash(./gradlew :shared:linkDebugFrameworkIosSimulatorArm64*)",
      "Bash(./gradlew :androidApp:assembleDebug*)",
      "Bash(./gradlew :androidApp:lintDebug*)",
      "Bash(./gradlew testAndroidHostTest koverXmlReport*)",
      "Bash(./gradlew tasks*)",
      "Bash(./gradlew :*:tasks*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Read(./local.properties)",
      "Edit(./local.properties)",
      "Read(./**/google-services.json)",
      "Edit(./**/google-services.json)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/GoogleService-Info.plist)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-secrets.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-gradle.sh"
          }
        ]
      }
    ]
  }
}
